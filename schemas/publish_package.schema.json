{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaocaimiPublishPackage",
  "type": "object",
  "required": [
    "article_id", "title", "slug", "meta_description", "primary_keyword", "search_intent",
    "content", "content_format", "content_type", "category", "site_category_key",
    "rule_refs", "source_refs", "fingerprint", "content_hash", "status"
  ],
  "properties": {
    "article_id": {"type": "string"},
    "title": {"type": "string"},
    "seo_title": {"type": "string"},
    "slug": {"type": "string"},
    "meta_description": {"type": "string"},
    "primary_keyword": {"type": "string"},
    "secondary_keywords": {"type": "array", "items": {"type": "string"}},
    "search_intent": {"type": "string"},
    "summary": {"type": "string"},
    "category": {"type": "string"},
    "site_category_key": {"type": "string"},
    "content_type": {"type": "string"},
    "content_format": {"const": "html"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "content": {"type": "string"},
    "internal_links": {"type": "array"},
    "rule_refs": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "case_scope": {"enum": ["mechanics_only", "economics"]},
    "provider_id": {"type": ["string", "null"]},
    "lottery": {"type": ["string", "null"]},
    "play": {"type": ["string", "null"]},
    "technique_atoms": {"type": "array", "items": {"type": "string"}},
    "fingerprint": {"type": "string"},
    "content_hash": {"type": "string"},
    "approved_at": {"type": "string"},
    "status": {"const": "approved"}
  }
}
