{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaocaimiPublishPackage",
  "type": "object",
  "required": ["article_id", "title", "slug", "meta_description", "primary_keyword", "search_intent", "content", "category", "rule_refs", "source_refs", "status"],
  "properties": {
    "article_id": {"type": "string"},
    "title": {"type": "string"},
    "slug": {"type": "string"},
    "meta_description": {"type": "string"},
    "primary_keyword": {"type": "string"},
    "secondary_keywords": {"type": "array", "items": {"type": "string"}},
    "search_intent": {"type": "string"},
    "category": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "content": {"type": "string"},
    "internal_links": {"type": "array"},
    "rule_refs": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "case_scope": {"enum": ["mechanics_only", "economics"]},
    "status": {"const": "approved"}
  }
}
